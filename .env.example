# ====================================================================
# ENERGYTOOL - ИИ-консультант для сайта
# Центральный файл-образец переменных окружения
# Скопируйте в .env и заполните свои значения (не коммитьте .env)
# ====================================================================

# -------------------- PostgreSQL --------------------
# Параметры подключения к PostgreSQL. Внутри контейнера хост всегда postgres,
# порт 5432 (контейнерный). POSTGRES_PORT маппится наружу.
POSTGRES_DB=hackaton
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret
POSTGRES_HOST=postgres
POSTGRES_PORT=5432                        # Порт, видимый снаружи контейнера

# -------------------- Redis --------------------
# Параметры подключения к Redis. Внутри контейнера хост redis, порт 6379.
# Пароль - пустая строка для dev-окружения.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# -------------------- Backend (PHP Yii2) --------------------
# Основные параметры PHP-бэкенда
APP_ENV=dev                               # dev / prod
APP_DEBUG=true                            # true / false
APP_NAME="Script Agency Energytool"       # Название приложения
DEBUG_LVL=3                               # 0 - только Yii2 debug, 1 - +trace,
                                          # 2 - +request, 3 - всё включено
APP_URL="http://localhost:8080"           # Базовый URL приложения (для ссылок)
COOKIE_VALIDATION_KEY="docker-dev-key-change-in-production"  # Ключ подписи кук
ADMIN_EMAIL="admin@example.com"           # Email администратора
SENDER_EMAIL="noreply@example.com"        # Email отправителя писем
SENDER_NAME="Script Agency Energytool"    # Имя отправителя писем

# -------------------- Frontend (React виджет) --------------------
# URL, по которому фронтенд обращается к бэкенду (используется при сборке)
FRONTEND_URL="http://localhost"

# -------------------- Порты (снаружи контейнера) --------------------
# Маппинг портов из контейнера на хост-машину.
# Внутри контейнера сервисы всегда слушают на стандартных портах.
BACKEND_PORT=8080                         # Nginx backend API (REST API + Swagger)
FRONTEND_PORT=80                          # Nginx frontend (демо-страница + виджет)
GENERATION_PORT=8000                      # Python Generation Service (FastAPI)

# -------------------- AI (OpenAI-compatible) --------------------
# Параметры подключения к AI-провайдеру (OpenAI или совместимый).
# Меняйте AI_BASE_URL для использования альтернативного провайдера
# (например, LM Studio, Ollama, Yandex GPT, GigaChat).
AI_BASE_URL="https://api.openai.com/v1"   # Базовый URL API провайдера
AI_API_KEY=""                             # API-ключ (обязателен для работы)
AI_MODEL="gpt-4o-mini"                    # Имя модели
AI_HTTP_TIMEOUT=300                       # Тайм-аут HTTP-запроса к AI (сек)
AI_CONNECT_TIMEOUT=15                     # Тайм-аут соединения с AI (сек)
AI_MAX_RETRIES=2                          # Число повторов при ошибке AI

# -------------------- Generation Service (Python) --------------------
# Параметры Python-сервиса генерации (RAG + оркестрация диалога)
PHP_INTERNAL_API_URL="http://nginx-backend"  # Внутренний URL бэкенда (внутри сети Docker)
INTERNAL_SERVICE_TOKEN="HAKATON_NO_AUTH"     # Токен для служебных запросов между сервисами
PHP_HTTP_TIMEOUT=60                           # Тайм-аут запроса к PHP (сек)
PHP_AI_GATEWAY_TIMEOUT=180                    # Тайм-аут генерации ответа AI (сек)
GENERATION_TOP_K=6                            # Количество релевантных чанков
GENERATION_MAX_CONTEXT_CHARS=24000            # Макс. длина контекста в символах
GENERATION_CHUNK_SIZE_CHARS=3500              # Размер чанка (в символах)
GENERATION_CHUNK_OVERLAP_CHARS=350            # Перекрытие чанков (в символах)
GENERATION_KNOWLEDGE_LIMIT=30                 # Лимит загружаемых документов знаний

# -------------------- Knowledge Base (база знаний) --------------------
# Параметры хранения и кэширования базы знаний
KNOWLEDGE_STORAGE_PATH=/app/storage/knowledge  # Путь к файлам знаний (в контейнере)
KNOWLEDGE_MAX_FILE_SIZE=20971520               # Макс. размер файла (байт)
KNOWLEDGE_MAX_PART_SIZE=1048576                # Макс. размер части файла (байт)
KNOWLEDGE_MAX_INLINE_PART_BYTES=262144         # Макс. размер инлайн-части (байт)
KNOWLEDGE_REDIS_TTL=3600                       # TTL кэша знаний в Redis (сек)
GENERATION_SERVICE_URL=http://generation:8000  # URL сервиса генерации (внутри Docker)
GENERATION_HTTP_TIMEOUT=180                    # Тайм-аут запроса к сервису генерации (сек)
GENERATION_CONNECT_TIMEOUT=5                   # Тайм-аут соединения с сервисом генерации (сек)