# -------------------- Application --------------------
APP_NAME="Script Agency Energytool"
APP_ENV=dev                             # dev / prod
APP_DEBUG=true                          # true / false
DEBUG_LVL=3                             # 0 - включен yii2 debug, 1 - вкючен trace, 2 - добавлен request, 3 - включено всё
APP_URL="http://localhost:8080"         # базовый URL приложения
COOKIE_VALIDATION_KEY="docker-dev-secret-change-in-production"   # ключ для валидации кук
ADMIN_EMAIL="company@thescript.agency"
SENDER_EMAIL="company@thescript.agency"
SENDER_NAME="Script Agency Energytool"
APP_SECRET="docker-dev-secret-change-in-production"

# -------------------- FRONTEND --------------------
FRONTEND_URL="http://localhost"

# -------------------- Database --------------------
DB_DSN="pgsql:host=postgres;port=5432;dbname=hackaton"
DB_USERNAME="postgres"
DB_PASSWORD="secret"

# -------------------- Redis --------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# -------------------- AI Module --------------------
AI_HTTP_TIMEOUT=300
AI_CONNECT_TIMEOUT=15
AI_MAX_RETRIES=2
